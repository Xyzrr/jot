{
  "name": "@jot/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot --env-file=.env index.ts",
    "build": "pip install -r requirements.txt && bun build index.ts --outdir dist --target bun",
    "start": "bun run --env-file=.env dist/index.js",
    "install:python": "pip install -r requirements.txt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.0.6",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "ai": "4.0.18",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
