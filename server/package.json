{
  "name": "@jot/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot --env-file=.env index.ts",
    "build": "pip install -r requirements.txt && bun build index.ts --outdir dist --target bun",
    "start": "bun run --env-file=.env dist/index.js",
    "install:python": "pip install -r requirements.txt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@braintrust/otel": "^0.1.2",
    "@vercel/otel": "^2.1.0",
    "ai": "^6.0.6",
    "braintrust": "^1.1.1",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
