{
  "name": "jot",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"bun --filter @jot/server dev\" \"bun --filter @jot/web dev\"",
    "build": "bun --filter @jot/server build && bun --filter @jot/web build",
    "start": "bun --filter @jot/server start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
